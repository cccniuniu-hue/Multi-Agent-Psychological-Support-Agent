# Copy to .env for Docker Compose. Do not commit the real .env file.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash

# Embeddings are separate from DeepSeek chat. Leave blank for local keyword fallback.
OPENAI_API_KEY=
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_API_KEY=

# Optional Marker PDF/DOCX upload limits.
MARKER_MAX_FILE_BYTES=10485760
MARKER_TIMEOUT_SECONDS=120
