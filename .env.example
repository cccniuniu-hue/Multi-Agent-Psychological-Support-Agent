# Copy to .env for Docker Compose. Do not commit the real .env file.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash

# Embeddings are separate from DeepSeek chat. Leave blank for local keyword fallback.
OPENAI_API_KEY=
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_API_KEY=

# Each retrieval route can contribute up to 50 candidates before fusion.
RAG_COARSE_RECALL_LIMIT=50

# Optional Marker PDF/DOCX upload limits.
MARKER_ENABLED=false
MARKER_BASE_URL=http://marker:8001
MARKER_CLIENT_TIMEOUT_SECONDS=125
MARKER_MAX_FILE_BYTES=10485760
MARKER_TIMEOUT_SECONDS=120

# Optional local Qwen2-VL image description service.
QWEN2VL_ENABLED=false
QWEN2VL_BASE_URL=http://qwen2vl:8002
QWEN2VL_CLIENT_TIMEOUT_SECONDS=65
QWEN2VL_MODEL=Qwen/Qwen2-VL-7B-Instruct
QWEN2VL_MAX_IMAGE_BYTES=10485760
QWEN2VL_TIMEOUT_SECONDS=60
QWEN2VL_MAX_NEW_TOKENS=512
